---
import Base from '../layouts/Base.astro';
import { site, people, papers, news, teaching, awards } from '../data/site.js';

const sameAs = Object.values(site.links).filter(Boolean);
const person = {
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  givenName: site.givenName,
  familyName: site.familyName,
  url: `${site.url}/`,
  image: site.url + site.photo,
  jobTitle: 'PhD Student in Computer Science and Engineering',
  description:
    'Computer Science PhD student at the University of Michigan and a researcher with Censored Planet, advised by Prof. Roya Ensafi. Works on Internet security and privacy, including censorship circumvention, web tracking, and cloud security. Co-author of CenKL (IEEE S&P 2027).',
  affiliation: [
    { '@type': 'CollegeOrUniversity', name: 'University of Michigan', url: 'https://cse.engin.umich.edu/' },
    { '@type': 'ResearchOrganization', name: 'Censored Planet', url: 'https://censoredplanet.org/' },
  ],
  memberOf: { '@type': 'ResearchOrganization', name: 'Censored Planet', url: 'https://censoredplanet.org/' },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Lahore University of Management Sciences',
    url: 'https://lums.edu.pk/',
  },
  knowsAbout: site.topics,
  sameAs,
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${site.url}/#profile`,
    url: `${site.url}/`,
    name: site.name,
    dateModified: new Date().toISOString(),
    mainEntity: person,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: `${site.url}/`,
    name: site.name,
    author: { '@id': `${site.url}/#person` },
  },
];
---

<Base
  title="Shabbir Hussain — PhD Student, University of Michigan CSE"
  ogTitle="Shabbir Hussain — CS PhD Student, University of Michigan"
  ogType="profile"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <meta property="profile:first_name" content={site.givenName} />
    <meta property="profile:last_name" content={site.familyName} />
  </Fragment>

  <div class="layout">
    <header class="side">
      <img
        class="photo"
        src={site.photo}
        width={site.photoWidth}
        height={site.photoHeight}
        alt="Portrait of Shabbir Hussain"
        fetchpriority="high"
      />
      <h1>{site.name}</h1>
      <p class="role">CS PhD student @ University of Michigan</p>
      <ul class="links">
        <li class="email">{site.emailDisplay}</li>
        {site.links.scholar && <li><a href={site.links.scholar} rel="me">Google Scholar</a></li>}
        {site.links.orcid && <li><a href={site.links.orcid} rel="me">ORCID</a></li>}
        <li><a href={site.links.github} rel="me">GitHub</a></li>
        <li><a href={site.links.linkedin} rel="me">LinkedIn</a></li>
        <li><a href={site.cvPdf}>CV</a></li>
      </ul>
    </header>

    <main>
      <section id="about">
        <h2>About</h2>
        <p>
          I am a PhD student in Computer Science and Engineering at the
          <a href="https://cse.engin.umich.edu/">University of Michigan</a>, advised by
          <a href={people.roya.url}>Prof. Roya Ensafi</a> as part of <a href={people.lab.url}>Censored Planet</a>. My
          research is in network security and privacy: I measure how Internet users are censored and tracked, and
          build systems that help defend against it. Most recently I have worked on how censors detect circumvention
          tools from the shape of their traffic. My earlier research studied web tracking and misconfigurations in
          cloud applications.
        </p>
        <p>
          Before joining Michigan in 2025, I received my BS in Computer Science from the Lahore University of
          Management Sciences (LUMS).
        </p>
      </section>

      <section id="updates">
        <h2>Updates</h2>
        <ul class="rows">
          {
            news.map((n) => (
              <li>
                <span class="date">{n.date}</span>
                <span set:html={n.html} />
              </li>
            ))
          }
        </ul>
      </section>

      <section id="publications">
        <h2>Publications</h2>
        {
          papers.map((p) => (
            <article class="pub">
              <h3>
                <a href={`/papers/${p.slug}/`}>{p.title}</a>
              </h3>
              <p class="authors" set:html={p.authors.map((a) => (a === site.name ? `<strong>${a}</strong>` : a)).join(', ')} />
              <p class="venue">
                <em>{p.venue}</em>, {p.year}
              </p>
              <ul class="actions">
                {p.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
                <li>
                  <a href={`/papers/${p.slug}/#bibtex`}>BibTeX</a>
                </li>
              </ul>
            </article>
          ))
        }
      </section>

      <section id="teaching">
        <h2>Teaching</h2>
        <ul class="rows">
          {
            teaching.map((t) => (
              <li>
                <span class="date">{t.date}</span>
                <span>{t.text}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="awards">
        <h2>Awards</h2>
        <ul class="plain">
          {awards.map((a) => <li>{a}</li>)}
        </ul>
      </section>
    </main>
  </div>
</Base>
