---
import Base from '../../layouts/Base.astro';
import { site, papers } from '../../data/site.js';

export function getStaticPaths() {
  return papers.map((paper) => ({ params: { slug: paper.slug }, props: { paper } }));
}

const { paper } = Astro.props;
const url = `${site.url}/papers/${paper.slug}/`;
const description = `${paper.shortTitle} (${paper.venueShort} ${paper.year}) measures how distinguishable censorship circumvention traffic is from real-world TLS, and which packets give it away.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ScholarlyArticle',
    '@id': `${url}#article`,
    url,
    mainEntityOfPage: url,
    headline: paper.title,
    name: paper.title,
    abstract: paper.abstract,
    datePublished: String(paper.year),
    author: paper.authors.map((name) =>
      name === site.name
        ? { '@type': 'Person', '@id': `${site.url}/#person`, name, url: `${site.url}/` }
        : { '@type': 'Person', name }
    ),
    isPartOf: { '@type': 'PublicationIssue', name: `${paper.venue} ${paper.year}` },
    publisher: { '@type': 'Organization', name: 'IEEE' },
    sameAs: paper.pdf,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: paper.shortTitle, item: url },
    ],
  },
];
---

<Base
  title={`${paper.shortTitle}: Visibility into Censorship Circumvention Traffic | ${site.name}`}
  ogTitle={paper.title}
  description={description}
  ogType="article"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <meta name="citation_title" content={paper.title} />
    {paper.authors.map((a) => <meta name="citation_author" content={a} />)}
    <meta name="citation_publication_date" content={String(paper.year)} />
    <meta name="citation_conference_title" content="IEEE Symposium on Security and Privacy" />
    <meta name="citation_pdf_url" content={paper.pdf} />
  </Fragment>

  <div class="narrow">
  <a class="back" href="/">← {site.name}</a>

  <main>
    <header class="paper-head">
      <h1>{paper.title}</h1>
      <p class="authors" set:html={paper.authors.map((a) => (a === site.name ? `<strong>${a}</strong>` : a)).join(', ')} />
      <p class="venue"><em>{paper.venue}</em>, {paper.year}</p>
      <ul class="actions">
        {
          paper.links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </header>

    <section id="abstract">
      <h2>Abstract</h2>
      <p>{paper.abstract}</p>
    </section>

    <section id="bibtex">
      <h2>BibTeX</h2>
      <pre><code>{paper.bibtex}</code></pre>
    </section>
  </main>
  </div>
</Base>
