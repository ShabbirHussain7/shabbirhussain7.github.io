---
import Base from '../../layouts/Base.astro';
import { site, papers } from '../../data/site.js';

export function getStaticPaths() {
  return papers.map((paper) => ({ params: { slug: paper.slug }, props: { paper } }));
}

const { paper } = Astro.props;
const url = `${site.url}/papers/${paper.slug}/`;
const description = paper.description;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ScholarlyArticle',
    '@id': `${url}#article`,
    url,
    mainEntityOfPage: url,
    headline: paper.title,
    name: paper.title,
    abstract: paper.abstract,
    datePublished: paper.date ?? String(paper.year),
    author: paper.authors.map((name) =>
      name === site.name
        ? { '@type': 'Person', '@id': `${site.url}/#person`, name, url: `${site.url}/` }
        : { '@type': 'Person', name }
    ),
    ...(paper.conference && { isPartOf: { '@type': 'PublicationIssue', name: `${paper.venue} ${paper.year}` } }),
    ...(paper.publisher && { publisher: { '@type': 'Organization', name: paper.publisher } }),
    ...(paper.arxiv && { identifier: `arXiv:${paper.arxiv}` }),
    sameAs: paper.arxiv ? `https://arxiv.org/abs/${paper.arxiv}` : paper.pdf,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: paper.shortTitle, item: url },
    ],
  },
];
---

<Base
  title={`${paper.pageTitle} | ${site.name}`}
  ogTitle={paper.title}
  description={description}
  ogType="article"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <meta name="citation_title" content={paper.title} />
    {paper.authors.map((a) => <meta name="citation_author" content={a} />)}
    <meta name="citation_publication_date" content={paper.date ?? String(paper.year)} />
    {paper.conference && <meta name="citation_conference_title" content={paper.conference} />}
    {paper.arxiv && <meta name="citation_arxiv_id" content={paper.arxiv} />}
    <meta name="citation_pdf_url" content={paper.pdf} />
  </Fragment>

  <div class="narrow">
  <a class="back" href="/">← {site.name}</a>

  <main>
    <header class="paper-head">
      <h1>{paper.title}</h1>
      <p class="authors" set:html={paper.authors.map((a) => (a === site.name ? `<strong>${a}</strong>` : a)).join(', ')} />
      <p class="venue"><em>{paper.venue}</em>, {paper.year}{paper.status && <> · {paper.status}</>}</p>
      {paper.related && <p class="venue" set:html={paper.related} />}
      <ul class="actions">
        {
          paper.links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </header>

    <section id="abstract">
      <h2>Abstract</h2>
      <p>{paper.abstract}</p>
    </section>

    {
      paper.codeHtml && (
        <section id="code">
          <h2>Code</h2>
          <p set:html={paper.codeHtml} />
        </section>
      )
    }

    <section id="bibtex">
      <h2>BibTeX</h2>
      <pre><code>{paper.bibtex}</code></pre>
    </section>
  </main>
  </div>
</Base>
